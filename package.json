{
  "name": "nightreign-cheatsheet",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
    "e2e": "playwright test",
    "check": "tsc -b && vitest run && playwright test",
    "fetch-raw": "node --experimental-strip-types scripts/fetch-raw.ts",
    "import": "node --experimental-strip-types scripts/import-seeds.ts && node --experimental-strip-types scripts/import-enemies.ts",
    "screens": "node --experimental-strip-types scripts/screens.ts"
  },
  "dependencies": {
    "@use-gesture/react": "^10.3.1",
    "motion": "^13.4.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1"
  }
}
